{
  "name": "t3-code-bar-desktop",
  "version": "2.0.0-alpha.3",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc --noEmit && vite build",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "tauri": "tauri",
    "generate:contracts": "cargo run --quiet --manifest-path crates/bar-identity/Cargo.toml --example export -- --write",
    "check:contracts": "cargo run --quiet --manifest-path crates/bar-identity/Cargo.toml --example export -- --check"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.0.0",
    "lucide-react": "^0.564.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@tauri-apps/cli": "2.12.4",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.7.0",
    "jsdom": "^26.1.0",
    "typescript": "^5.9.3",
    "vite": "^7.2.2",
    "vitest": "^4.1.12"
  }
}
